{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dossiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "properties": {
          "key": {"type": "string"},
          "design_quality": {"type": "number", "minimum": 0, "maximum": 100},
          "endpoint_hardness": {"type": "number", "minimum": 0, "maximum": 100},
          "recruitment_burden": {"type": "number", "minimum": 0, "maximum": 100},
          "powering_plausibility": {"type": "number", "minimum": 0, "maximum": 100},
          "multiplicity": {"type": "number", "minimum": 0, "maximum": 100},
          "therapeutic_area": {
            "type": "string",
            "enum": [
              "cardiovascular",
              "oncology",
              "respiratory_infectious",
              "neurology_psychiatry",
              "metabolic_endocrine",
              "musculoskeletal",
              "renal_hepatic_gastrointestinal",
              "reproductive",
              "immunology",
              "dermatology",
              "other"
            ]
          },
          "protocol_risk": {"type": "number", "minimum": 0, "maximum": 100}
        },
        "required": [
          "key",
          "design_quality",
          "endpoint_hardness",
          "recruitment_burden",
          "powering_plausibility",
          "multiplicity",
          "therapeutic_area",
          "protocol_risk"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["dossiers"],
  "additionalProperties": false
}

